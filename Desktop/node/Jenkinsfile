
pipeline {
    agent any

    stages {

        stage('Build Docker Image') {
            steps {
                dir('Desktop/node') {
                    sh 'docker build -t sample-node-app:latest .'
                }
            }
        }

        stage('Deploy Application') {
            steps {
                sh '''
                    docker stop sample-node-app || true
                    docker rm sample-node-app || true
                    docker run -d \
                        --name sample-node-app \
                        -p 3000:3000 \
                        sample-node-app:latest
                '''
            }
        }
    }
}
